{
  "name": "fs-elem",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "import": "node scripts/import.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node apps/web/node_modules/typescript/bin/tsc --project apps/web/tsconfig.json --incremental false",
    "setup:release": "node scripts/setup-release.mjs --install",
    "check:release": "node scripts/setup-release.mjs --check",
    "start:release": "node scripts/start-release.mjs",
    "test:web": "node --test apps/web/lib/*.test.mjs",
    "test:release-platform": "node --test --test-concurrency=1 tests/release/*.test.mjs"
  },
  "packageManager": "pnpm@11.19.0"
}
