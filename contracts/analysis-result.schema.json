{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "videoId",
    "sourceSha256",
    "model",
    "coordinateSpace",
    "frames"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "pose2d"
    },
    "status": {
      "const": "model_proposal"
    },
    "videoId": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "weightsSha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "version": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "weightsSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "width",
        "height"
      ],
      "properties": {
        "type": {
          "const": "image-normalized"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frameIndex",
          "time",
          "landmarks"
        ],
        "properties": {
          "frameIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "landmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "x",
                "y",
                "confidence"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": ".*\\S.*"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Runtime validator additionally checks increasing frame indices/times, unique landmark names and optional source binding."
}
